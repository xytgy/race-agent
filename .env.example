# LLM API 密钥，用于访问语言模型服务
LLM_API_KEY=your_api_key_here

# API 密钥，用于接口鉴权
API_KEY=your_api_key_here

# LLM API 基础 URL
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 使用的语言模型名称
LLM_MODEL=mimo-v2.5-pro

# API 请求超时时间（秒）
LLM_TIMEOUT_SECONDS=30

# API 请求最大重试次数
LLM_MAX_RETRIES=2

# 嵌入模型名称，用于文本向量化
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Embedding 调用方式：默认不依赖外部服务；可选 remote / local / auto
EMBEDDING_PROVIDER=fallback_hash

# 可选：远程 embedding 服务配置；不需要 OpenAI 账号，只要接口兼容 /embeddings 即可
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=1

# 向量库实现：当前支持 faiss，后续可扩展 milvus
VECTOR_STORE=faiss

# 任务生成编排引擎：simple 为默认稳定模式，langgraph 启用 LangGraph
TASK_WORKFLOW_ENGINE=simple

# 数据存储目录
DATA_DIR=data
